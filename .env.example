# 复制为 .env 后填。.env 已在 .gitignore 里，不会被提交。
# ★ 这里列出的每一项都对应 ecom_agent/config.py 里的一个 os.getenv，
#   新增配置时两处一起改，否则会出现"文档里有、代码里没有"的幽灵开关。

# ── LLM ──────────────────────────────────────────────────
# 必填。注意：browser-use 的 ChatDeepSeek 不会自己读这个变量名，
# 必须由 config.py 读出后显式传给 ChatDeepSeek(api_key=...)。
# （实测：不传会回退去读 OPENAI_API_KEY，然后报一个与 DeepSeek 毫无关系的错。）
DEEPSEEK_API_KEY=

# 真实调用 LLM 的总开关。默认 false —— 单测和 CI 全部走假 LLM，零 token。
# ★ 注意是"双条件"：这个开关为 true 且 DEEPSEEK_API_KEY 非空，才会真的联网。
#   只满足一个，config.LIVE_LLM 仍为 False（避免 key 缺失时跑一半炸掉）。
ECOM_AGENT_ENABLE_LIVE_LLM=false

# ── 浏览器 ────────────────────────────────────────────────
# 留空 = 让 browser-use 自己探测系统 Chrome。
# 填绝对路径 = 指定二进制（本机开发常指向 playwright 缓存的 Chrome for Testing，
# 好处是零下载、版本固定）。
# ★ 设为空字符串是"明确的自动探测"，与"未设置"不同：未设置时 Windows 上会回落到
#   开发机路径（见 config.py），空字符串则强制走探测逻辑 —— CI 用后者。
ECOM_AGENT_CHROME_PATH=

# 无头模式。调试阶段可设 false 肉眼看它点哪 —— 这是排查"LLM 为什么点错"最快的手段。
ECOM_AGENT_HEADLESS=true

# ── 持久登录 profile（只有要跑真站点时才需要）─────────────
# 留空 = **不使用**持久 profile：每次 run 一个临时 profile，无状态、可复现。
#   ★ 默认必须是无状态的：CI 和本地那 13 条浏览器用例会共用一个 cookie 目录，
#     互相污染，而且只在特定执行顺序下才暴露。
# 填目录 = 复用那个目录里的登录 cookie（有状态）。
#
# ★★★ 这一行**必须与 devtools/login_pdd.py 用的是同一个目录**，否则会静默地
#     以"需要人工登录"收尾、零行数据 —— 不报错、不崩溃、只是没有数据。
#     完整经过（库会把 user_data_dir 偷偷拷到临时目录这件事）见 docs/spikes.md
#     的「Phase 6 探路结论」。
#
# 用法（人工登录；agent 永不碰登录表单 —— 这是红线，不是省事）：
#   1) uv run python devtools/login_pdd.py --profile D:/python2/ecom-agent/browser_profile
#      会打开一个浏览器让你扫码。登录成功后脚本用**新会话**复核，
#      复核通过才写标记 —— 不通过就不写，免得留下"以为登录了"的假象。
#   2) 把下面这行取消注释，目录填脚本打印出来的那个
#   3) uv run python main.py run tasks/pdd_shop_overview.yaml
#
# ECOM_AGENT_USER_DATA_DIR=D:/python2/ecom-agent/browser_profile

# ── 护栏 ──────────────────────────────────────────────────
# 人工审批的等待上限（秒）。超时一律按【拒绝】处理（fail-closed），不是放行。
ECOM_AGENT_APPROVAL_TIMEOUT_S=300
